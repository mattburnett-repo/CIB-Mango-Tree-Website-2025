  "macOS (Apple Silicon)":
    '<svg viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16 text-[#555555]"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>',
  Debian:
    '<svg viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16 text-[#A80030]"><path d="M13.88 12.685c-.4 0 .08.2.601.28.14-.1.27-.22.39-.33a3.001 3.001 0 01-.99.05m2.14-.53c.23-.33.4-.69.47-1.06-.06.27-.2.5-.33.73-.75.47-.07-.27 0-.56-.8 1.01-.11.6-.14.89m.781-2.05c.05-.721-.14-.501-.2-.221.07.04.13.5.2.22M12.38.31c.2.04.45.07.42.12.23-.05.28-.1-.43-.12m.43.12l-.15.03.14-.01V.43m6.633 9.944c.02.64-.2.95-.38 1.5l-.35.181c-.28.54.03.35-.17.78-.44.39-1.34 1.22-1.62 1.301-.201 0 .14-.25.19-.34-.591.4-.481.6-1.371.85l-.03-.06c-2.221 1.04-5.303-1.02-5.253-3.842-.03.17-.07.13-.12.2a3.551 3.552 0 012.001-3.501 3.361 3.362 0 013.732.48 3.341 3.342 0 00-2.721-1.3c-1.18.01-2.281.76-2.651 1.57-.6.38-.67 1.47-.93 1.661-.361 2.601.66 3.722 2.38 5.042.27.19.08.21.12.35a4.702 4.702 0 01-1.53-1.16c.23.33.47.66.8.91-.55-.18-1.27-1.3-1.48-1.35.93 1.66 3.78 2.921 5.261 2.3a6.203 6.203 0 01-2.33-.28c-.33-.16-.77-.51-.7-.57a5.802 5.803 0 005.902-.84c.44-.35.93-.94 1.07-.95-.2.32.04.16-.12.44.44-.72-.2-.3.46-1.24l.24.33c-.09-.6.74-1.321.66-2.262.19-.3.2.3 0 .97.29-.74.08-.85.15-1.46.08.2.18.42.23.63-.18-.7.2-1.2.28-1.6-.09-.05-.28.3-.32-.53 0-.37.1-.2.14-.28-.08-.05-.26-.32-.38-.861.08-.13.22.33.34.34-.08-.42-.2-.75-.2-1.08-.34-.68-.12.1-.4-.3-.34-1.091.3-.25.34-.74.54.77.84 1.96.981 2.46-.1-.6-.28-1.2-.49-1.76.16.07-.26-1.241.21-.37A7.823 7.824 0 0017.702 1.6c.18.17.42.39.33.42-.75-.45-.62-.48-.73-.67-.61-.25-.65.02-1.06 0C15.082.73 14.862.8 13.8.4l.05.23c-.77-.25-.9.1-1.73 0-.05-.04.27-.14.53-.18-.741.1-.701-.14-1.431.03.17-.13.36-.21.55-.32-.6.04-1.44.35-1.18.07C9.6.68 7.847 1.3 6.867 2.22L6.838 2c-.45.54-1.96 1.611-2.08 2.311l-.131.03c-.23.4-.38.85-.57 1.261-.3.52-.45.2-.4.28-.6 1.22-.9 2.251-1.16 3.102.18.27 0 1.65.07 2.76-.3 5.463 3.84 10.776 8.363 12.006.67.23 1.65.23 2.49.25-.99-.28-1.12-.15-2.08-.49-.7-.32-.85-.7-1.34-1.13l.2.35c-.971-.34-.57-.42-1.361-.67l.21-.27c-.31-.03-.83-.53-.97-.81l-.34.01c-.41-.501-.63-.871-.61-1.161l-.111.2c-.13-.21-1.52-1.901-.8-1.511-.13-.12-.31-.2-.5-.55l.14-.17c-.35-.44-.64-1.02-.62-1.2.2.24.32.3.45.33-.88-2.172-.93-.12-1.601-2.202l.15-.02c-.1-.16-.18-.34-.26-.51l.06-.6c-.63-.74-.18-3.102-.09-4.402.07-.54.53-1.1.88-1.981l-.21-.04c.4-.71 2.341-2.872 3.241-2.761.43-.55-.09 0-.18-.14.96-.991 1.26-.7 1.901-.88.7-.401-.6.16-.27-.151 1.2-.3.85-.7 2.421-.85.16.1-.39.14-.52.26 1-.49 3.151-.37 4.562.27 1.63.77 3.461 3.011 3.531 5.132l.08.02c-.04.85.13 1.821-.17 2.711l.2-.42M9.54 13.236l-.05.28c.26.35.47.73.8 1.01-.24-.47-.42-.66-.75-1.3m.62-.02c-.14-.15-.22-.34-.31-.52.08.32.26.6.43.88l-.12-.36m10.945-2.382l-.07.15c-.1.76-.34 1.511-.69 2.212.4-.73.65-1.541.75-2.362M12.45.12c.27-.1.66-.05.95-.12-.37.03-.74.05-1.1.1l.15.02M3.006 5.142c.07.57-.43.8.11.42.3-.66-.11-.18-.1-.42m-.64 2.661c.12-.39.15-.62.2-.84-.35.44-.17.53-.2.83"/></svg>',
};

if (downloadPageData.docs.length > 0) {
  for (const layoutBlock of downloadPageData.docs[0].layout) {
    if (layoutBlock.blockType === "platformDownloadList")
      platformDownloadList = layoutBlock;
    if (
      layoutBlock.blockType === "linkButtons" &&
      layoutBlock.blockName === "Help Buttons"
    )
      helpButtons = layoutBlock;
    if (
      layoutBlock.blockType === "linkButtons" &&
      layoutBlock.blockName === "Demo Data"
    )
      demoDataButtons = layoutBlock;
  }
}

const demoDataButton = demoDataButtons?.items?.[0] ?? null;

const dataPreparationSteps = [
  {
    step: 1,
    title: "Gather Your Data",
    description:
      "Export social media data from platforms like Twitter/X, Facebook, or use datasets from academic sources.",
  },
  {
    step: 2,
    title: "Format as CSV",
    description:
      "Ensure your data is in CSV format with columns for: user_id, username, post_content, timestamp, and engagement_metrics.",
  },
  {
    step: 3,
    title: "Clean & Validate",
    description:
      "Remove duplicates, handle missing values, and ensure text encoding is UTF-8 for consistent analysis.",
  },
  {
    step: 4,
    title: "Run Analysis",
    description:
      "Use the CLI to run detection tests on your prepared dataset. Start with the copypasta test for quick results.",
  },
];
---

<Layout>
  <!-- Hero Section -->
  <section class="flex-container-wrapper">
    <div class="flex-container-main w-full px-6 xl:w-5xl xl:px-0">
      <h1
        class="font-bold text-4xl md:text-5xl lg:text-6xl mb-10 leading-tight"
      >
        Download CIB Mango Tree
      </h1>

      <p class="text-xl text-muted mb-16 leading-relaxed max-w-3xl">
        Get CIB Mango Tree running on your machine in minutes. Our tools run
        locally, ensuring your data stays private and secure.
      </p>
    </div>
  </section>
  <!-- Platform Downloads -->
  <section class="flex justify-center py-16 bg-[#F8F6F2]">
    <div class="flex-container-main w-full px-6 xl:w-5xl xl:px-0">
      <h2 class="font-bold text-3xl mb-12 text-center">Choose Your Platform</h2>
      {
        platformDownloadList?.items != null && (
          <PlatformDownload
            platforms={platformDownloadList.items.map(
              (item: PlatformDownloadListItem): Platform => ({
                ...item,
                icon: platformIcons[item.name],
              }),
            )}
          />
        )
      }
      <p class="text-center text-muted text-sm mt-10">
        All downloads include the full CIB Mango Tree GUI with all detection
        modules.
      </p>
      {
        demoDataButton != null && (
          <div class="mt-12 flex flex-col items-center text-center gap-6 w-full bg-white border border-border p-8 opacity-0 animate-fade-in-scale animate-delay-400 transition-all transform-gpu duration-300 ease-default hover:border-[#5A8A4A] hover:shadow-[0_1.0rem_2.50rem_rgba(90,138,74,0.15)] hover:-translate-y-1">
            <div class="flex flex-col items-center">
              <h3 class="font-bold text-2xl mb-3">Demo Data</h3>
              <p class="text-muted max-w-2xl">
                New to the tool? Download a sample CSV dataset to run your first
                analysis without preparing your own data.
              </p>
            </div>
            <DemoDataDownload
              client:visible
              href={demoDataButton.link}
              label={demoDataButton.name}
              variant={demoDataButton.type}
              hoverAnimation={demoDataButton["hover effect"] ?? true}
            />
          </div>
        )
      }
    </div>
  </section>
  <!-- Data Preparation -->
  <section class="flex-container-wrapper bg-mango-yellow-light">
    <div class="flex-container-main w-full px-6 xl:w-5xl xl:px-0">
      <h2 class="font-bold text-3xl mb-6">Preparing Your Data</h2>
      <p class="text-muted mb-12 max-w-3xl">
        Before running analysis, you'll need to prepare your social media
        dataset. Follow these steps:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          dataPreparationSteps.map((item, index) => (
            <div
              class="bg-white p-8 relative group opacity-0 transition-all transform-gpu duration-300 ease-linear animate-fade-in-step hover:-translate-y-1 hover:shadow-[0_0.5rem_1.25rem_rgba(90,138,74,0.15)]"
              style={`animation-delay: ${index * 0.1}s;`}
            >
              <div class="absolute -top-3 -left-3 w-12 h-12 bg-mango-green-dark text-white font-bold flex items-center justify-center text-lg transition-all transform-gpu duration-300 ease-default group-hover:bg-[#4a7a3a] group-hover:scale-110 group-hover:-rotate-5">
                {item.step}
              </div>
              <h3 class="font-semibold mb-4 mt-3">{item.title}</h3>
              <p class="text-muted text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
      <!-- CSV Format Example -->
      <div class="mt-12 bg-white w-full p-8 border border-border">
        <h3 class="font-semibold mb-5">Expected CSV Format</h3>
        <div class="overflow-x-auto">
          <CodeBlock
            client:visible
            code='user_id,username,post_content,timestamp,retweets,likes<br/>12345,@example_user,"Sample post content here",2025-01-15T10:30:00Z,5,12'
          />
        </div>
      </div>
    </div>
  </section>
  <!-- Technical Documentation -->
  <section class="flex justify-center py-16 bg-mango-green-dark text-white">
    <div
      class="flex flex-col items-center justify-center gap-8 w-full px-6 lg:flex-row lg:justify-between xl:w-5xl xl:px-0"
    >
      <div class="flex flex-col items-center lg:items-start">
        <h2 class="font-bold text-2xl mb-3">Technical Documentation</h2>
        <p class="text-white/80">
          Detailed API reference, advanced configuration, and integration
          guides.
        </p>
      </div>
      <BaseButton
        href="https://civictechdc.github.io/cib-mango-tree"
        target="_blank"
        rel="noopener noreferrer"
        variant="secondary"
        hoverAnimation
      >
        <BookOpen class="w-5 h-5" />
        View Documentation
      </BaseButton>
    </div>
  </section>
  <!-- Help Section -->
  <section class="flex justify-center py-16 bg-background">
    <div class="flex-container-main text-center w-full px-6 xl:w-5xl xl:px-0">
      <h3 class="font-bold text-2xl mb-6">Need Help?</h3>
      <p class="text-muted mb-8">
        Check our documentation or reach out to the community
      </p>
      <div class="flex flex-wrap justify-center gap-5">
        {
          helpButtons?.items != null
            ? helpButtons.items.map(
                (item): HTMLElement => (
                  <BaseButton
                    href={item.link}
                    variant={item.type}
                    target={
                      !item.link.startsWith("https://cibmangotree.org/") &&
                      !item.link.startsWith("http://localhost")
                        ? "_blank"
                        : "_self"
                    }
                    hoverAnimation={
                      item["hover effect"] != null
                        ? item["hover effect"]
                        : false
                    }
                  >
                    {item.name}
                  </BaseButton>
                ),
              )
            : null
        }
      </div>
    </div>
  </section>
</Layout>

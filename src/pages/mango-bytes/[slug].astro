---
import Layout from "@layouts/Layout.astro";
import AstroBlockRenderer from "@components/AstroBlockRenderer.astro";
import { getMangoBytes, formatMangoDate, type MangoByte } from "@lib/mangoBytes";
export const prerender = false;

const { slug } = Astro.params;
let post: MangoByte | null = null;
let failed = false;
try {
  if (slug) post = (await getMangoBytes({ slug, limit: 1 })).docs[0] ?? null;
} catch (error) {
  console.error("Unable to load Mango Byte:", error);
  failed = true;
}
if (failed) Astro.response.status = 503;
else if (!post) Astro.response.status = 404;
---

<Layout>
  <main class="max-w-4xl mx-auto px-6 py-16">
    <div class="flex flex-wrap items-center gap-6 mb-10">
      <a href="/resources#mango-bytes" class="text-mango-green-dark font-semibold hover:underline">← Back to Resources</a>
      {post && formatMangoDate(post.publishedAt) && <time datetime={post.publishedAt!} class="text-muted">{formatMangoDate(post.publishedAt)}</time>}
    </div>
    {post ? (
      <article>
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-10">{post.title}</h1>
        {post.meta?.description && <p class="text-xl text-muted leading-relaxed mb-10">{post.meta.description}</p>}
        {post.content && <AstroBlockRenderer data={post.content} />}
      </article>
    ) : (
      <div>
        <h1 class="text-3xl font-bold mb-4">{failed ? "Article temporarily unavailable" : "Article not found"}</h1>
        <p class="text-muted">{failed ? "We couldn’t reach the content service. Please try again shortly." : "This article may be unpublished or its address may have changed."}</p>
      </div>
    )}
  </main>
</Layout>
